# ═══════════════════════════════════════════════════════════════════════════
# Protronics — environment template
# Copy to `.env` (or `.env.local`) and fill in values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# Site URL (local or production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google Sheets form integration (required for live forms) ─────────────
# 1. Create a Google Spreadsheet
# 2. Extensions → Apps Script → paste scripts/Code.gs
# 3. Run setupSheets() once, then setupEmailNotifications() once
# 4. Deploy → New deployment → Web app
#      Execute as: Me
#      Who has access: Anyone
# 5. Paste the /exec URL below (both names are supported)

NEXT_PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
NEXT_PUBLIC_FORM_ENDPOINT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec

# Local/CI: skip build warning when endpoint is empty (set to 0 for production checks)
FORMS_SKIP_ASSERT=1

# CI only: fail the build if form endpoint is missing
# FORMS_REQUIRE_ENDPOINT=1

# ─── Email notifications (configured in Google Apps Script, NOT here) ─────
# After pasting Code.gs, run setupEmailNotifications() in the Apps Script editor.
# Or set Script Properties manually:
#   NOTIFICATION_EMAIL = Protronicspro4@gmail.com
#   NOTIFY_ENABLED     = true
#   NOTIFY_FROM_NAME   = Protronics Forms
# Multiple recipients: comma-separated emails in NOTIFICATION_EMAIL

# ─── Optional analytics / SEO ─────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# NEXT_PUBLIC_GOOGLE_MAPS_DIRECTIONS_URL=
