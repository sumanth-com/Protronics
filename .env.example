# ═══════════════════════════════════════════════════════════════════════════
# Protronics — environment template
# Copy to `.env` (or `.env.local`) and fill in values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# Site URL
# Local: http://localhost:3000
# Production (Vercel): https://protronics.store  ← required for correct canonicals/sitemap/OG
NEXT_PUBLIC_SITE_URL=https://protronics.store

# ─── Google Sheets form integration (required for live forms) ─────────────
# Forms post to /api/forms (server). The Apps Script URL must stay SERVER-ONLY.
# 1. Create a Google Spreadsheet
# 2. Extensions → Apps Script → paste scripts/Code.gs
# 3. Run setupSheets() once, then setupEmailNotifications() once
# 4. Optional: set Script property FORM_WEBHOOK_SECRET (match FORM_WEBHOOK_SECRET below)
# 5. Deploy → New deployment → Web app
#      Execute as: Me
#      Who has access: Anyone
# 6. Paste the /exec URL below (do NOT use NEXT_PUBLIC_ for this)

FORM_ENDPOINT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec

# Optional shared secret (also set as Apps Script Script property FORM_WEBHOOK_SECRET)
# FORM_WEBHOOK_SECRET=generate-a-long-random-string

# Legacy aliases still accepted by the server (prefer FORM_ENDPOINT_URL):
# GOOGLE_SHEETS_WEBHOOK_URL=
# NEXT_PUBLIC_FORM_ENDPOINT=   # deprecated — do not expose webhook to the browser

# Local/CI: skip build warning when endpoint is empty
# FORMS_SKIP_ASSERT=1

# ─── Optional analytics / SEO / social ────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=UVQBIxkLv3m2ax-ACBVPhAS999Ywy8KvFNG6aaLTM5s
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# NEXT_PUBLIC_GOOGLE_MAPS_DIRECTIONS_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yourhandle/
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/yourpage/
